# Local development
GCP_PROJECT=your-project-id
GCP_LOCATION=us
USE_VERTEX=true
# or Developer API: USE_VERTEX=false and GEMINI_API_KEY=...
GEMINI_API_KEY=
MODEL_MAIN=gemini-3.8-flash
MODEL_LITE=gemini-3.1-flash-lite
MODEL_LIVE=gemini-3.8-live
# The older native-audio model was unavailable on the shared 'us' endpoint.
# Same model means there is no independent voice fallback until another is verified.
MODEL_LIVE_FALLBACK=gemini-3.8-live
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us
STORE_BACKEND=memory
USE_DLP=false
SHARE_SECRET=dev-only-change-me
CONSOLE_KEY=
OPEN_WORKSPACE=true
CASE_COLLECTION=cases
# Browser-owned reports: no login; case capabilities are handled automatically.
# Institutional responder deployments set OPEN_WORKSPACE=false and a private CONSOLE_KEY.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional cloud-only values (deployment supplies these; leave blank for local memory mode)
EVIDENCE_BUCKET=
TASKS_QUEUE=
PUBLIC_BASE_URL=

# Cloud Tasks OIDC callback identity (deployment sets this automatically)
TASKS_SERVICE_ACCOUNT=
